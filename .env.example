# MAPS_API_KEY: Required for live Google Maps tiles and Places discovery in Android.
# Configure your Google Maps SDK for Android API key in the AI Studio Secrets panel.
MAPS_API_KEY=MY_MAPS_API_KEY

# BACKEND_BASE_URL: Optional Node.js emergency dispatch backend URL (e.g. Cloud Run / HTTPS).
BACKEND_BASE_URL=https://api.safeguard-sos.example.com
